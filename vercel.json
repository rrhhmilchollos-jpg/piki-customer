{
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/release.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self), payment=(self)" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; base-uri 'self'" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/trpc/:path*",
      "destination": "https://api.pikidelivery.com/api/trpc/:path*"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://api.pikidelivery.com/api/v1/:path*"
    },
    { "source": "/partners", "destination": "/index.html" },
    { "source": "/riders", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/unete", "destination": "/unete/index.html" },
    { "source": "/unete/", "destination": "/unete/index.html" },
    { "source": "/comida-a-domicilio-xativa", "destination": "/comida-a-domicilio-xativa/index.html" },
    { "source": "/comida-a-domicilio-xativa/", "destination": "/comida-a-domicilio-xativa/index.html" }
  ]
}
